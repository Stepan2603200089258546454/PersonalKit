@page "/Account/Login"

@using System.ComponentModel.DataAnnotations
@using Common.Security.OpenIddict.Server.Security
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using DevHome.Identity.DataContext.Models

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IDeviceIdentityService DeviceIdentityService
@inject IUserSecurityService UserSecurityService
@inject ILogger<Login> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Вход</PageTitle>

<h1>Вход</h1>
<p class="text-body-secondary small">
    При входе сохраняются устройство, браузер, IP-адрес, время и приложение, из которого
    выполнен вход. Это нужно, чтобы вы могли заметить чужой сеанс и завершить его.
    Один и тот же браузер на одном компьютере считается одним устройством.
</p>
<div class="row">
    <div class="col-lg-6">
        <section>
            <StatusMessage Message="@errorMessage" />
            <EditForm EditContext="editContext" method="post" OnSubmit="LoginUser" FormName="login">
                <DataAnnotationsValidator />
                <h2>Войдите с помощью локальной учётной записи.</h2>
                <hr />
                <div role="alert" aria-atomic="true">
                    <ValidationSummary class="text-danger" />
                </div>
                <div class="form-floating mb-3">
                    <InputText @bind-Value="Input.Email" id="Input.Email" class="form-control" autocomplete="username webauthn" aria-required="true" placeholder="name@example.com" />
                    <label for="Input.Email" class="form-label">
                        <DisplayName For="() => Input.Email" />
                    </label>
                    <ValidationMessage For="() => Input.Email" class="text-danger" />
                </div>
                <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="Input.Password" id="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Пароль" />
                <label for="Input.Password" class="form-label">
                    <DisplayName For="() => Input.Password" />
                </label>
                <ValidationMessage For="() => Input.Password" class="text-danger" />
                </div>
                <div class="checkbox mb-3">
                    <label class="form-label">
                        <InputCheckbox @bind-Value="Input.RememberMe" class="darker-border-checkbox form-check-input" />
                        Запомнить меня
                    </label>
                </div>
                <div>
                    <button type="submit" class="w-100 btn btn-lg btn-primary">Войти</button>
                </div>
                <hr />
                <div class="d-flex flex-column">
                    <span class="text-secondary mx-auto mt-2">ИЛИ</span>
                    <PasskeySubmit Operation="PasskeyOperation.Request" Name="Input.Passkey" EmailName="Input.Email" class="btn btn-link mx-auto">Войти с помощью ключа доступа</PasskeySubmit>
                </div>
                <hr />
                <div>
                    <p>
                        <a href="Account/ForgotPassword">Забыли пароль?</a>
                    </p>
                    <p>
                        <a href="@(NavigationManager.GetUriWithQueryParameters("Account/Register", new Dictionary<string, object?> { ["ReturnUrl"] = ReturnUrl }))">Зарегистрироваться как новый пользователь</a>
                    </p>
                    <p>
                        <a href="Account/ResendEmailConfirmation">Повторно отправить подтверждение адреса электронной почты</a>
                    </p>
                </div>
            </EditForm>
        </section>
    </div>
    <div class="col-lg-4 col-lg-offset-2">
        <section>
            <h3>Войдите через другую службу.</h3>
            <hr />
            <ExternalLoginPicker />
        </section>
    </div>
</div>

@code {
    private string? errorMessage;
    private EditContext editContext = default!;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromTempData(Name = IdentityRedirectManager.StatusMessageKey)]
    private string? IdentityStatusMessage { get; set; }

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        errorMessage = IdentityStatusMessage;
        IdentityStatusMessage = null;
        Input ??= new();

        editContext = new EditContext(Input);

        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            // Удаляем существующую внешнюю cookie, чтобы вход начинался с чистого листа
            await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);
        }
    }

    public async Task LoginUser()
    {
        if (!string.IsNullOrEmpty(Input.Passkey?.Error))
        {
            errorMessage = $"Ошибка: {Input.Passkey.Error}";
            return;
        }

        SignInResult result;
        if (!string.IsNullOrEmpty(Input.Passkey?.CredentialJson))
        {
            // Ключ доступа тоже подчиняется политике устройств. Проверяем её
            // до входа, чтобы не создавать сеанс, который сразу будет отозван.
            if (!string.IsNullOrWhiteSpace(Input.Email))
            {
                var passkeyUser = await UserManager.FindByEmailAsync(Input.Email);
                if (passkeyUser is not null)
                {
                    var passkeyPolicyError = await CheckDevicePolicyAsync(passkeyUser);
                    if (passkeyPolicyError is not null)
                    {
                        errorMessage = passkeyPolicyError;
                        return;
                    }
                }
            }

            // При входе по ключу доступа проверку формы не выполняем.
            result = await SignInManager.PasskeySignInAsync(Input.Passkey.CredentialJson);
        }
        else
        {
            // При входе по паролю проверяем форму.
            if (!await editContext.ValidateAsync())
            {
                return;
            }

            // Неудачные попытки входа не приближают блокировку учётной записи.
            // Чтобы неудачные попытки входа приводили к блокировке, укажите lockoutOnFailure: true.
            //
            // Вход выполняется по имени пользователя, но пользователь вводит почту.
            // Обычно они совпадают, однако администратор может задать отдельное имя,
            // поэтому сначала ищем по имени, затем по адресу почты.
            var user = await UserManager.FindByNameAsync(Input.Email)
                ?? await UserManager.FindByEmailAsync(Input.Email);

            if (user is null)
            {
                errorMessage = "Ошибка: неверная попытка входа.";
                return;
            }

            var userName = await UserManager.GetUserNameAsync(user);
            if (string.IsNullOrEmpty(userName))
            {
                errorMessage = "Ошибка: у учётной записи не задано имя пользователя.";
                return;
            }

            // Проверяем пароль до установки cookie, чтобы при конфликте политики
            // устройств показать сообщение, а не молча выйти на следующем запросе.
            var check = await SignInManager.CheckPasswordSignInAsync(
                user,
                Input.Password,
                lockoutOnFailure: false);

            if (check.Succeeded || check.RequiresTwoFactor)
            {
                var policyError = await CheckDevicePolicyAsync(user);
                if (policyError is not null)
                {
                    errorMessage = policyError;
                    return;
                }
            }

            result = await SignInManager.PasswordSignInAsync(userName, Input.Password, Input.RememberMe, lockoutOnFailure: false);
        }

        if (result.Succeeded)
        {
            Logger.LogInformation("Пользователь вошёл в систему.");
            RedirectManager.RedirectTo(ReturnUrl);
        }
        else if (result.RequiresTwoFactor)
        {
            RedirectManager.RedirectTo(
                "Account/LoginWith2fa",
                new() { ["returnUrl"] = ReturnUrl, ["rememberMe"] = Input.RememberMe });
        }
        else if (result.IsLockedOut)
        {
            Logger.LogWarning("Учётная запись пользователя заблокирована.");
            RedirectManager.RedirectTo("Account/Lockout");
        }
        else
        {
            errorMessage = "Ошибка: неверная попытка входа.";
        }
    }

    private async Task<string?> CheckDevicePolicyAsync(ApplicationUser user)
    {
        var userId = await UserManager.GetUserIdAsync(user);
        var resolution = await DeviceIdentityService.ResolveAsync(userId, HttpContext);

        if (resolution.IsBlocked)
        {
            return "Вход с этого устройства заблокирован. " +
                   "Разблокировать его может пользователь в разделе «Безопасность» или администратор.";
        }

        var decision = await UserSecurityService.EvaluateSignInAsync(userId, resolution.Device.Id);
        return decision.IsAllowed ? null : decision.Message;
    }

    private sealed class InputModel
    {
        [Required]
        [EmailAddress]
        [Display(Name = "Электронная почта")]
        public string Email { get; set; } = "";

        [Required]
        [DataType(DataType.Password)]
        [Display(Name = "Пароль")]
        public string Password { get; set; } = "";

        [Display(Name = "Запомнить меня?")]
        public bool RememberMe { get; set; }

        public PasskeyInputModel? Passkey { get; set; }
    }
}
