@page "/admin/sessions"
@attribute [Authorize(Roles = AdminRoles.Administrator)]
@attribute [MenuItem("Сеансы и устройства", Description = "Кто, откуда и с какого устройства вошёл; отзыв и блокировка", Section = AdminNavigation.Section, Icon = "bi bi-laptop", Roles = AdminRoles.Administrator, Order = 620)]
@rendermode InteractiveServer
@layout DevHome.Identity.Components.Admin.Shared.AdminLayout

@using System.Security.Claims
@using Common.Security.OpenIddict.Server.Security
@using Microsoft.AspNetCore.Components.Authorization

@inject IUserSecurityService SecurityService
@inject UserManager<ApplicationUser> UserManager
@inject ILogger<Sessions> Logger

<PageTitle>Сеансы и устройства</PageTitle>

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h2 class="h4 mb-1">Сеансы и устройства</h2>
        <p class="text-body-secondary mb-0 small">
            Действующих сеансов: <strong>@sessions.Count</strong> · событий в журнале: <strong>@audit.Count</strong>
        </p>
    </div>
    <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@isBusy" @onclick="LoadAsync">
        <i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>Обновить
    </button>
</div>

@if (message is not null)
{
    <div class="alert @(isError ? "alert-danger" : "alert-success") alert-dismissible" role="alert">
        @message
    </div>
}

<div class="alert alert-info" role="status">
    <div class="fw-semibold mb-1">Что здесь видно</div>
    <p class="mb-1 small">
        Каждый вход создаёт сеанс. В нём сохраняются пользователь, устройство, браузер,
        операционная система, IP-адрес, время и приложение, из которого выполнен вход.
        Один и тот же браузер на одном компьютере считается одним устройством — его узнают
        по постоянной cookie. Очистка cookie или другой браузер создают новое устройство.
    </p>
    <p class="mb-0 small">
        «Завершить» отзывает конкретный сеанс и токены связанных приложений. «Заблокировать
        устройство» завершает все его сеансы и запрещает будущие входы с него. Блокировку
        можно снять; старые сеансы при этом не восстанавливаются.
    </p>
</div>

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span class="fw-semibold">Действующие сеансы</span>
        <span class="badge text-bg-light border">@sessions.Count</span>
    </div>
    @if (sessions.Count == 0)
    {
        <div class="card-body text-body-secondary">Действующих сеансов нет.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Пользователь</th>
                        <th scope="col">Устройство</th>
                        <th scope="col">Приложения</th>
                        <th scope="col">Где</th>
                        <th scope="col">Когда</th>
                        <th scope="col" class="text-end">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var session in sessions)
                    {
                        <tr>
                            <td>
                                <a class="text-decoration-none" href="@AdminNavigation.User(session.UserId)">
                                    @UserLabel(session.UserId)
                                </a>
                            </td>
                            <td>
                                <div class="fw-semibold">@session.DeviceName</div>
                                <div class="small text-body-secondary">
                                    @session.Browser · @session.OperatingSystem
                                </div>
                            </td>
                            <td class="small">
                                @(session.ApplicationName ?? session.ClientId)
                                @if (session.Applications.Count > 0)
                                {
                                    <div class="text-body-secondary">
                                        @string.Join(", ", session.Applications.Select(app => app.ApplicationName ?? app.ClientId))
                                    </div>
                                }
                            </td>
                            <td class="small">
                                <div class="text-break">@(session.IpAddress ?? "IP неизвестен")</div>
                                <div class="text-body-secondary">@(session.Location ?? "локация не определена")</div>
                            </td>
                            <td class="small">
                                <div>вход: @FormatDate(session.CreatedAt)</div>
                                <div class="text-body-secondary">активность: @FormatDate(session.LastSeenAt)</div>
                            </td>
                            <td class="text-end">
                                <div class="d-flex flex-column gap-1 align-items-end">
                                    <button type="button" class="btn btn-sm btn-outline-danger" disabled="@isBusy"
                                            @onclick="() => RevokeSessionAsync(session)">
                                        <i class="bi bi-box-arrow-right me-1" aria-hidden="true"></i>Завершить
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-warning" disabled="@isBusy"
                                            @onclick="() => BlockDeviceAsync(session)">
                                        <i class="bi bi-slash-circle me-1" aria-hidden="true"></i>Заблокировать
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="card">
    <div class="card-header fw-semibold">Последние события безопасности</div>
    @if (audit.Count == 0)
    {
        <div class="card-body text-body-secondary">Событий пока нет.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Время</th>
                        <th scope="col">Событие</th>
                        <th scope="col">Пользователь</th>
                        <th scope="col">Приложение</th>
                        <th scope="col">Устройство</th>
                        <th scope="col">Где</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in audit)
                    {
                        <tr>
                            <td class="small text-nowrap">@FormatDate(item.OccurredAt)</td>
                            <td>
                                <span class="badge @EventBadgeClass(item.EventType)">@DescribeEvent(item.EventType)</span>
                                @if (!string.IsNullOrWhiteSpace(item.Details))
                                {
                                    <div class="small text-body-secondary text-break">@item.Details</div>
                                }
                            </td>
                            <td class="small">
                                <a class="text-decoration-none" href="@AdminNavigation.User(item.UserId)">@UserLabel(item.UserId)</a>
                            </td>
                            <td class="small">@(item.ApplicationName ?? item.ClientId ?? "—")</td>
                            <td class="small">@(item.DeviceName ?? "—")</td>
                            <td class="small">
                                @(item.IpAddress ?? "—")
                                @if (!string.IsNullOrWhiteSpace(item.Location))
                                {
                                    <div class="text-body-secondary">@item.Location</div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private bool isBusy;
    private string? message;
    private bool isError;
    private string? adminUserId;
    private List<SessionSummary> sessions = [];
    private List<LoginAuditSummary> audit = [];
    private Dictionary<string, string> userLabels = new(StringComparer.Ordinal);

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask is null)
        {
            return;
        }

        var state = await AuthenticationStateTask;
        adminUserId = state.User.FindFirstValue(ClaimTypes.NameIdentifier);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isBusy = true;
        try
        {
            sessions = [.. await SecurityService.GetAllActiveSessionsAsync(200)];
            audit = [.. await SecurityService.GetAllAuditAsync(200)];

            var userIds = sessions.Select(session => session.UserId)
                .Concat(audit.Select(item => item.UserId))
                .Distinct(StringComparer.Ordinal)
                .ToList();

            var labels = new Dictionary<string, string>(StringComparer.Ordinal);
            foreach (var userId in userIds)
            {
                var user = await UserManager.FindByIdAsync(userId);
                labels[userId] = user?.Email ?? user?.UserName ?? userId;
            }

            userLabels = labels;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Не удалось загрузить сеансы и устройства.");
            SetError("Не удалось загрузить данные: " + exception.Message);
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task RevokeSessionAsync(SessionSummary session)
    {
        if (string.IsNullOrWhiteSpace(adminUserId))
        {
            return;
        }

        isBusy = true;
        try
        {
            await SecurityService.RevokeSessionAsync(
                session.UserId,
                session.Id,
                adminUserId,
                "Администратор завершил сеанс.");

            SetSuccess($"Сеанс пользователя {UserLabel(session.UserId)} завершён, токены отозваны.");
            await LoadAsync();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Не удалось завершить сеанс {SessionId}.", session.Id);
            SetError("Не удалось завершить сеанс: " + exception.Message);
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task BlockDeviceAsync(SessionSummary session)
    {
        if (string.IsNullOrWhiteSpace(adminUserId))
        {
            return;
        }

        isBusy = true;
        try
        {
            await SecurityService.BlockDeviceAsync(
                session.UserId,
                session.DeviceId,
                adminUserId,
                "Устройство заблокировано администратором.");

            SetSuccess($"Устройство «{session.DeviceName}» заблокировано, его сеансы отозваны.");
            await LoadAsync();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Не удалось заблокировать устройство {DeviceId}.", session.DeviceId);
            SetError("Не удалось заблокировать устройство: " + exception.Message);
        }
        finally
        {
            isBusy = false;
        }
    }

    private string UserLabel(string userId) =>
        userLabels.TryGetValue(userId, out var label) ? label : userId;

    private void SetSuccess(string text)
    {
        message = text;
        isError = false;
    }

    private void SetError(string text)
    {
        message = text;
        isError = true;
    }

    private static string DescribeEvent(string eventType) => eventType switch
    {
        UserSecurityEventTypes.SignIn => "Вход",
        UserSecurityEventTypes.SignInRejected => "Вход отклонён",
        UserSecurityEventTypes.SignOut => "Выход",
        UserSecurityEventTypes.ApplicationAuthorized => "Вход в приложение",
        UserSecurityEventTypes.SessionRevoked => "Сеанс завершён",
        UserSecurityEventTypes.AllSessionsRevoked => "Все сеансы завершены",
        UserSecurityEventTypes.DeviceBlocked => "Устройство заблокировано",
        UserSecurityEventTypes.DeviceUnblocked => "Устройство разблокировано",
        UserSecurityEventTypes.PolicyChanged => "Политика изменена",
        _ => eventType
    };

    private static string EventBadgeClass(string eventType) => eventType switch
    {
        UserSecurityEventTypes.SignIn or UserSecurityEventTypes.ApplicationAuthorized => "text-bg-success",
        UserSecurityEventTypes.SignInRejected or UserSecurityEventTypes.SessionRevoked
            or UserSecurityEventTypes.AllSessionsRevoked => "text-bg-danger",
        UserSecurityEventTypes.DeviceBlocked => "text-bg-warning",
        _ => "text-bg-secondary"
    };

    private static string FormatDate(DateTimeOffset value) =>
        value.ToLocalTime().ToString("g", CultureInfo.CurrentCulture);
}
