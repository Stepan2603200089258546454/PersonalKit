@page "/admin"
@attribute [Authorize(Roles = AdminRoles.Administrator)]
@attribute [MenuItem("Обзор", Description = "Сводка по пользователям и OpenIddict", Section = AdminNavigation.Section, Icon = "bi bi-speedometer2", Roles = AdminRoles.Administrator, Order = 600)]
@rendermode InteractiveServer
@layout DevHome.Identity.Components.Admin.Shared.AdminLayout

@inject IDbContextFactory<DBContext> DbFactory
@inject IOpenIddictApplicationManager ApplicationManager
@inject IOpenIddictScopeManager ScopeManager
@inject IConfiguration Configuration
@inject IHostEnvironment Environment
@inject NavigationManager Navigation
@inject ILogger<Dashboard> Logger

<PageTitle>Администрирование</PageTitle>

@if (loadError is not null)
{
    <div class="alert alert-danger" role="alert">
        <strong>Не удалось загрузить сводку.</strong>
        <div class="small">@loadError</div>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 bg-primary-subtle text-primary-emphasis d-flex align-items-center justify-content-center flex-shrink-0" style="width: 3rem; height: 3rem;">
                    <i class="bi bi-people fs-4" aria-hidden="true"></i>
                </div>
                <div class="min-w-0">
                    <div class="fs-4 fw-semibold lh-1">@UserCount</div>
                    <div class="small text-body-secondary">Пользователи</div>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a class="small text-decoration-none" href="@AdminNavigation.Users">Управление пользователями</a>
            </div>
        </div>
    </div>

    <div class="col-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 bg-success-subtle text-success-emphasis d-flex align-items-center justify-content-center flex-shrink-0" style="width: 3rem; height: 3rem;">
                    <i class="bi bi-window-stack fs-4" aria-hidden="true"></i>
                </div>
                <div class="min-w-0">
                    <div class="fs-4 fw-semibold lh-1">@ApplicationCount</div>
                    <div class="small text-body-secondary">Клиенты</div>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a class="small text-decoration-none" href="@AdminNavigation.Clients">Клиентские приложения</a>
            </div>
        </div>
    </div>

    <div class="col-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 bg-info-subtle text-info-emphasis d-flex align-items-center justify-content-center flex-shrink-0" style="width: 3rem; height: 3rem;">
                    <i class="bi bi-bounding-box-circles fs-4" aria-hidden="true"></i>
                </div>
                <div class="min-w-0">
                    <div class="fs-4 fw-semibold lh-1">@ScopeCount</div>
                    <div class="small text-body-secondary">Области</div>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a class="small text-decoration-none" href="@AdminNavigation.Scopes">Области доступа</a>
            </div>
        </div>
    </div>

    <div class="col-6 col-xl-3">
        <div class="card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 bg-warning-subtle text-warning-emphasis d-flex align-items-center justify-content-center flex-shrink-0" style="width: 3rem; height: 3rem;">
                    <i class="bi bi-key fs-4" aria-hidden="true"></i>
                </div>
                <div class="min-w-0">
                    <div class="fs-4 fw-semibold lh-1">@ValidTokenCount</div>
                    <div class="small text-body-secondary">
                        Действующие токены
                        <span class="d-block">всего @TokenCount</span>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a class="small text-decoration-none" href="@AdminNavigation.Tokens">Токены и авторизации</a>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-xl-7">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center justify-content-between">
                <span class="fw-semibold">Последние авторизации</span>
                <a class="small text-decoration-none" href="@AdminNavigation.Tokens">Все</a>
            </div>
            @if (RecentAuthorizations.Count == 0)
            {
                <div class="card-body text-body-secondary">Авторизаций пока нет: пользователи ещё не входили в клиентские приложения.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Пользователь</th>
                                <th scope="col">Клиент</th>
                                <th scope="col">Области</th>
                                <th scope="col">Состояние</th>
                                <th scope="col">Создана</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in RecentAuthorizations)
                            {
                                <tr>
                                    <td class="text-truncate" style="max-width: 12rem;">@item.Subject</td>
                                    <td><code>@item.ClientId</code></td>
                                    <td class="small text-body-secondary">@OpenIddictValueParser.FormatScopes(item.Scopes)</td>
                                    <td>
                                        <span class="badge @OpenIddictPermissionCatalog.StatusBadgeClass(item.Status)">
                                            @OpenIddictPermissionCatalog.DescribeStatus(item.Status)
                                        </span>
                                    </td>
                                    <td class="small text-body-secondary">@FormatDate(item.CreationDate)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="col-xl-5">
        <div class="card mb-4">
            <div class="card-header fw-semibold">Провайдер OpenID Connect</div>
            <div class="card-body">
                <dl class="row small mb-0">
                    <dt class="col-4 fw-normal text-body-secondary">Издатель</dt>
                    <dd class="col-8 text-break"><code>@Issuer</code></dd>
                    <dt class="col-4 fw-normal text-body-secondary">Ключи подписи</dt>
                    <dd class="col-8 mb-0">
                        @if (Environment.IsDevelopment())
                        {
                            <span class="badge text-bg-warning">в памяти: перезапуск отзывает токены</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">сертификаты приложения</span>
                        }
                    </dd>
                </dl>
            </div>
            <ul class="list-group list-group-flush small">
                @foreach (var endpoint in Endpoints)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
                        <span class="text-body-secondary">@endpoint.Title</span>
                        <a class="text-decoration-none text-truncate" href="@endpoint.Path" target="_blank" rel="noopener">
                            <code>@endpoint.Path</code>
                        </a>
                    </li>
                }
            </ul>
        </div>

        <div class="card">
            <div class="card-header fw-semibold">Пользователи</div>
            @if (RecentUsers.Count == 0)
            {
                <div class="card-body text-body-secondary">Пользователей пока нет.</div>
            }
            else
            {
                <ul class="list-group list-group-flush">
                    @foreach (var user in RecentUsers)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
                            <a class="text-decoration-none text-truncate" href="@AdminNavigation.User(user.Id)">@user.Email</a>
                            @if (user.EmailConfirmed)
                            {
                                <span class="badge text-bg-success">подтверждён</span>
                            }
                            else
                            {
                                <span class="badge text-bg-warning">без почты</span>
                            }
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</div>

@code {
    private const int RecentItemCount = 5;

    private int UserCount { get; set; }
    private long ApplicationCount { get; set; }
    private long ScopeCount { get; set; }
    private int AuthorizationCount { get; set; }
    private int TokenCount { get; set; }
    private int ValidTokenCount { get; set; }
    private List<UserRow> RecentUsers { get; } = [];
    private List<AuthorizationRow> RecentAuthorizations { get; } = [];
    private string? loadError;

    private string Issuer => Configuration["OpenIddict:Issuer"] is { Length: > 0 } issuer
        ? issuer
        : Navigation.BaseUri.TrimEnd('/');

    private IReadOnlyList<ProviderEndpoint> Endpoints { get; } =
    [
        new("Авторизация", "connect/authorize"),
        new("Токен", "connect/token"),
        new("Данные пользователя", "connect/userinfo"),
        new("Завершение сеанса", "connect/logout"),
        new("Код устройства", "connect/deviceauthorization"),
        new("Подтверждение кода", "connect/verify"),
        new("Метаданные", ".well-known/openid-configuration")
    ];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            UserCount = await db.Users.CountAsync();
            AuthorizationCount = await db.Set<OpenIddictEntityFrameworkCoreAuthorization>().CountAsync();
            TokenCount = await db.Set<OpenIddictEntityFrameworkCoreToken>().CountAsync();
            ValidTokenCount = await db.Set<OpenIddictEntityFrameworkCoreToken>()
                .CountAsync(token => token.Status == Statuses.Valid);

            ApplicationCount = await ApplicationManager.CountAsync();
            ScopeCount = await ScopeManager.CountAsync();

            RecentUsers.AddRange(await db.Users
                .AsNoTracking()
                .OrderBy(user => user.Email)
                .Take(RecentItemCount)
                .Select(user => new UserRow(user.Id, user.Email, user.EmailConfirmed))
                .ToListAsync());

            RecentAuthorizations.AddRange(await db.Set<OpenIddictEntityFrameworkCoreAuthorization>()
                .AsNoTracking()
                .OrderByDescending(authorization => authorization.CreationDate)
                .Take(RecentItemCount)
                .Select(authorization => new AuthorizationRow(
                    authorization.Id,
                    authorization.Subject,
                    authorization.Application != null ? authorization.Application.ClientId : null,
                    authorization.Scopes,
                    authorization.Status,
                    authorization.CreationDate))
                .ToListAsync());
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Не удалось загрузить сводку администрирования.");
            loadError = exception.Message;
        }
    }

    private static string FormatDate(DateTimeOffset? value) =>
        value is null ? "—" : value.Value.ToLocalTime().ToString("g", CultureInfo.CurrentCulture);

    private sealed record ProviderEndpoint(string Title, string Path);

    private sealed record UserRow(string Id, string? Email, bool EmailConfirmed);

    private sealed record AuthorizationRow(
        string? Id,
        string? Subject,
        string? ClientId,
        string? Scopes,
        string? Status,
        DateTimeOffset? CreationDate);
}
