{
  "Http": {
    "UseHttpsRedirection": false
  },
  "DBConfiguration": {
    "Version": "18.6.0",
    "PoolSize": 120
  },
  "OpenIddict": {
    "AllowHttp": true,
    "Seed": {
      "RefreshClients": true
    },
    "Certificates": {
      "Directory": "App_Data/OpenIddict"
    }
  },
  "Logging": {
    "LogLevel": {
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
