@page "/counter"
@attribute [MenuItem("Счётчик", Description = "Пример интерактивной страницы Blazor WebAssembly", Section = "Разделы", Icon = "bi bi-plus-square", Order = 20)]
@rendermode InteractiveAuto

<PageTitle>Счётчик</PageTitle>

<h1 class="h3 mb-3">Счётчик</h1>

<p role="status">Текущее значение: @currentCount</p>

<button class="btn btn-primary" @onclick="IncrementCount">Нажмите на меня</button>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }
}
