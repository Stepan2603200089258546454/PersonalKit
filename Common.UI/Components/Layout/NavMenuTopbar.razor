@* Верхняя панель: кнопка меню на мобильном, заголовок страницы,
   поиск, переключатель темы и блок пользователя. *@
<header class="cui-topbar d-flex align-items-center gap-2 bg-body px-2 px-lg-3">
    <button type="button"
            class="btn btn-link text-body d-lg-none p-2"
            data-bs-toggle="offcanvas"
            data-bs-target="@("#" + SidebarId)"
            aria-controls="@SidebarId"
            aria-label="Открыть меню">
        <i class="bi bi-list fs-4" aria-hidden="true"></i>
    </button>

    @if (Page is not null)
    {
        <div class="cui-topbar-title d-flex align-items-center gap-2">
            <span class="cui-topbar-page fw-semibold text-truncate d-none d-md-inline-block px-2 py-1 border rounded bg-body-secondary">
                @Page.Title
            </span>

            @if (!string.IsNullOrWhiteSpace(Page.Description))
            {
                <span class="cui-topbar-description text-body-secondary text-truncate d-none d-xl-inline-block"
                      title="@Page.Description">
                    @Page.Description
                </span>
            }
        </div>
    }

    <div class="ms-auto d-flex align-items-center gap-2">
        @if (Options.ShowSearch)
        {
            <form role="search" method="get" action="@Options.SearchUrl" class="d-none d-lg-flex mb-0">
                <div class="input-group input-group-sm">
                    <input type="search"
                           name="@Options.SearchParameter"
                           class="form-control"
                           placeholder="Поиск"
                           aria-label="Поисковый запрос" />
                    <button type="submit" class="btn btn-outline-secondary" aria-label="Найти">
                        <i class="bi bi-search" aria-hidden="true"></i>
                    </button>
                </div>
            </form>
        }

        @if (Options.ShowThemeSwitcher)
        {
            <ThemeSwitcher />
        }

        <AuthorizeView>
            <Authorized Context="auth">
                <div class="dropdown">
                    <button type="button"
                            class="btn btn-outline-secondary btn-sm dropdown-toggle d-flex align-items-center gap-2"
                            data-bs-toggle="dropdown"
                            aria-expanded="false">
                        <i class="bi bi-person-circle" aria-hidden="true"></i>
                        <span class="d-none d-md-inline text-truncate">@auth.User.Identity?.Name</span>
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end">
                        @if (!string.IsNullOrWhiteSpace(Options.ProfileUrl))
                        {
                            <li>
                                <a class="dropdown-item" href="@Options.ProfileUrl">
                                    <i class="bi bi-person me-2" aria-hidden="true"></i>Профиль
                                </a>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                        }

                        @if (!string.IsNullOrWhiteSpace(Options.LogoutUrl))
                        {
                            <li>
                                @if (Options.LogoutUsePost)
                                {
                                    <form method="post" action="@Options.LogoutUrl" class="m-0">
                                        @if (Options.UseAntiforgeryToken)
                                        {
                                            <AntiforgeryToken />
                                        }
                                        <input type="hidden" name="ReturnUrl" value="@CurrentUrl" />
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>Выход
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <a class="dropdown-item text-danger" href="@Options.LogoutUrl">
                                        <i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>Выход
                                    </a>
                                }
                            </li>
                        }
                    </ul>
                </div>
            </Authorized>
            <NotAuthorized>
                @if (!string.IsNullOrWhiteSpace(Options.LoginUrl))
                {
                    <a class="btn btn-primary btn-sm" href="@Options.LoginUrl">Войти</a>
                }

                @if (!string.IsNullOrWhiteSpace(Options.RegisterUrl))
                {
                    <a class="btn btn-outline-secondary btn-sm d-none d-sm-inline-block" href="@Options.RegisterUrl">
                        Регистрация
                    </a>
                }
            </NotAuthorized>
        </AuthorizeView>
    </div>
</header>

@code {
    [Parameter, EditorRequired]
    public NavigationMenuOptions Options { get; set; } = default!;

    [Parameter]
    public MenuPage? Page { get; set; }

    [Parameter]
    public string CurrentUrl { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string SidebarId { get; set; } = string.Empty;
}
