<Project>

  <PropertyGroup>
    <!-- Единый каталог сборки для всех проектов решения.
         В песочнице DSH запись в obj/bin существующих проектов запрещена,
         поэтому результаты сборки складываются в artifacts/ в корне рабочей области. -->
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
  </PropertyGroup>

</Project>
