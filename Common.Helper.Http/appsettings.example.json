// Пример заполнения настроек типизированных HTTP-клиентов Common.Helper.Http.
//
// .NET-провайдер JSON-конфигурации (AddJsonFile) разрешает комментарии // и /* */
// и висячие запятые, поэтому этот файл читается как обычный appsettings.json.
// Строгие JSON-редакторы могут подсвечивать комментарии как ошибку — это ожидаемо.
//
// Секция "HttpClients:ИмяКлиента" указывается при регистрации:
//   services.AddResilientHttpClient<IGitHubApi, GitHubApi>(configuration, "HttpClients:GitHub");
//   services.AddResilientHttpClient("InternalApi", configuration, "HttpClients:InternalApi");
//
// Все поля необязательны: отсутствующие значения берутся из свойств ResilientHttpClientOptions.
// Значения TimeSpan записываются строкой: "чч:мм:сс" или "чч:мм:сс.fff".
// Длительности срабатывают только при положительном значении; 0 отключает ограничение.

{
  "HttpClients": {
    // ---------------------------------------------------------------------
    // Подробный пример: все настройки заданы явно.
    // ---------------------------------------------------------------------
    "GitHub": {
      // Базовый адрес, к которому добавляются относительные пути запросов.
      // Только http/https. Без завершающего слэша трактуется как каталог:
      // "https://host/v1" и "https://host/v1/" работают одинаково.
      // Если в запросе передан абсолютный адрес, это значение игнорируется.
      "BaseAddress": "https://api.github.com/",

      // Общий таймаут одного запроса, включая все повторы и ожидание тела ответа.
      // По умолчанию 30 секунд. "00:00:00" — без ограничения.
      // При срабатывании бросается TaskCanceledException с внутренним TimeoutException.
      "Timeout": "00:00:30",

      // Заголовки, которые добавляются к каждому запросу.
      // Если такой заголовок уже задан в самом запросе, значение запроса имеет приоритет.
      // Заголовки содержимого (Content-Type и т. п.) сюда не входят.
      "DefaultHeaders": {
        "Accept": "application/vnd.github+json",
        "User-Agent": "PersonalKit",
        "X-Request-Source": "personal-kit"
      },

      // Настройки устойчивости: повторы, предохранитель, таймаут попытки.
      "Resilience": {
        // Если false — запросы уходят без повторов и предохранителя,
        // но таймауты (Timeout) и заголовки продолжают работать.
        "Enabled": true,

        // Повтор неуспешных запросов.
        "Retry": {
          // false — повторы отключены.
          "Enabled": true,

          // Количество повторов ПОСЛЕ первой попытки:
          // 3 = всего до 4 попыток; 0 = повторов нет (только одна попытка).
          "MaxRetryAttempts": 3,

          // Базовая задержка перед повтором.
          "Delay": "00:00:01",

          // Верхняя граница задержки при нарастании; не может быть меньше Delay.
          "MaxDelay": "00:00:30",

          // Как растёт задержка: "Constant", "Linear" или "Exponential".
          "BackoffType": "Exponential",

          // Добавлять случайный разброс к задержке, чтобы клиенты не били одновременно.
          "UseJitter": true,

          // Коды ответа, которые считаются временными ошибками и повторяются.
          // По умолчанию: 408, 429, 500, 502, 503, 504.
          // Транспортные исключения (HttpRequestException) и таймаут попытки повторяются всегда.
          "RetryStatusCodes": [408, 429, 500, 502, 503, 504],

          // Повторять ли POST и PATCH (неидемпотентные методы).
          // По умолчанию false: повтор такой операции может создать дубликат на сервере.
          // Включайте, только если сервер поддерживает идемпотентность (например, по ключу идемпотентности).
          // Особенно важно для браузера (Blazor WASM), где пользователь видит каждый повтор.
          "RetryNonIdempotentMethods": false
        },

        // Предохранитель (circuit breaker): временно перестаёт отправлять запросы,
        // если в окне выборки слишком много ошибок.
        "CircuitBreaker": {
          // false — предохранитель отключён.
          "Enabled": true,

          // Доля неуспешных вызовов в окне выборки, при которой предохранитель размыкается.
          // Допустимый диапазон: больше 0 и не больше 1.
          "FailureRatio": 0.5,

          // Минимальное число вызовов в окне, после которого предохранитель может разомкнуться.
          "MinimumThroughput": 100,

          // Длительность окна выборки, за которое считается доля ошибок.
          "SamplingDuration": "00:00:30",

          // Сколько предохранитель остаётся разомкнутым до пробного запроса.
          // Пока он разомкнут, запросы отклоняются с BrokenCircuitException.
          "BreakDuration": "00:00:05",

          // Коды ответа, которые считаются ошибкой для предохранителя.
          // По умолчанию: 408, 429, 500, 502, 503, 504.
          "BreakStatusCodes": [408, 429, 500, 502, 503, 504]
        },

        // Таймаут одной попытки (в отличие от общего Timeout).
        // Если попытка не уложилась, она считается неуспешной и может быть повторена.
        "AttemptTimeout": {
          // false — таймаут попытки отключён, ограничивает только общий Timeout.
          "Enabled": true,

          // Длительность попытки. Должна быть больше нуля, если Enabled = true.
          "Timeout": "00:00:10"
        }
      }
    },

    // ---------------------------------------------------------------------
    // Минимальный пример: заданы только адрес и общий таймаут,
    // остальные параметры берутся по умолчанию (повторы 3, предохранитель включён,
    // таймаут попытки 10 секунд).
    // ---------------------------------------------------------------------
    "InternalApi": {
      "BaseAddress": "https://internal.example.local/api/",
      "Timeout": "00:00:15"
    }
  }
}
