# Скопируйте этот файл в .env и отредактируйте значения.
# .env не попадает в git и Docker-образ.
#
# Обязательно задайте PUBLIC_HOST — IPv4-адрес компьютера в локальной сети
# (например, 192.168.1.50). Узнать: ipconfig, раздел «IPv4-адрес».
# Не указывайте http://, https:// и порт — только адрес или имя хоста.
PUBLIC_HOST=192.168.1.100

# Версия сборки. Попадает в тег образа и в ответ /health.
APP_VERSION=0.1.0

# Режим сборки: source (из исходников) или published (из publish/).
BUILD_MODE=source

# Порты на хосте. Если заняты, поменяйте.
IDENTITY_PORT=5201
WEB_PORT=5149

# Первый администратор Identity. В существующей базе достаточно указать
# почту зарегистрированного пользователя. В чистой базе, если задан пароль,
# пользователь будет создан с подтверждённой почтой и ролью Admin.
ADMIN_EMAIL=bulychev.stepan2000@gmail.com
# Замените перед первым запуском в пустой базе.
ADMIN_PASSWORD=ChangeMe!2026

# Подключение к существующему контейнеру PostgreSQL.
POSTGRES_NETWORK=postgresql_backend
POSTGRES_HOST=postgres_db
POSTGRES_DB=DevHome.Identity
POSTGRES_USER=postgres
POSTGRES_PASSWORD=SuperSecretPassword123!
POSTGRES_PORT=5432

# Версия PostgreSQL, размер пула, HTTP-режим, сертификаты OpenIddict
# и обновление клиентов заданы в appsettings.Production.json.

# Секреты клиентов OpenIddict. Для домашней сети можно оставить как есть;
# при изменении поменяйте и в соответствующем приложении (или в админке).
WEB_CLIENT_SECRET=devhome-web-development-secret
SERVICE_CLIENT_SECRET=devhome-service-development-secret
API_CLIENT_SECRET=devhome-api-development-secret

# Пароль самоподписанных сертификатов OpenIddict в томе identity-data.
OPENIDDICT_CERT_PASSWORD=devhome-docker-certificate
